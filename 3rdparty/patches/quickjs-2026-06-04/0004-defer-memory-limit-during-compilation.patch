+static void js_compile_enter(JSRuntime *rt)
+{
+    JSMallocState *ms = &rt->malloc_ctx.malloc_state;
+    if (rt->compile_depth++ == 0) {
+        rt->compile_out_of_memory = FALSE;
+        rt->compile_malloc_limit = ms->malloc_limit;
+        ms->malloc_limit = (size_t)-1;
+    }
+}
+
+static void js_compile_leave(JSRuntime *rt)
+{
+    if (--rt->compile_depth == 0)
+        rt->malloc_ctx.malloc_state.malloc_limit = rt->compile_malloc_limit;
+}
+
 /* use -1 to disable automatic GC */
 void JS_SetGCThreshold(JSRuntime *rt, size_t gc_threshold)
 {
@@ -22812,6 +22835,23 @@
 
 static __exception int next_token(JSParseState *s);
 
+/* Return -1 with an out of memory exception if the memory limit lifted by
+   js_compile_enter() has been exceeded. The failure is sticky: the parser
+   ignores some errors while looking ahead, and must not resume if a garbage
+   collection then frees memory. */
+static __exception int js_compile_check_memory(JSContext *ctx)
+{
+    JSRuntime *rt = ctx->rt;
+    if (rt->compile_depth > 0 &&
+        (rt->compile_out_of_memory ||
+         rt->malloc_ctx.malloc_state.malloc_size > rt->compile_malloc_limit)) {
+        rt->compile_out_of_memory = TRUE;
+        JS_ThrowOutOfMemory(ctx);
+        return -1;
+    }
+    return 0;
+}
