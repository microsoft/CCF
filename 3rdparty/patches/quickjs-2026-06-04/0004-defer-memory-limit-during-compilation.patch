+    /* The compiler does not handle allocation failures safely. While
+       compile_depth > 0, the memory limit is lifted and saved here; the
+       compiler tests it at safe points instead. Once a test has failed,
+       compile_out_of_memory makes every later one fail too. */
+    BOOL compile_out_of_memory : 8;
+    int compile_depth;
+    size_t compile_malloc_limit;
 
