+static int JS_EnsureIntrinsicDate(JSContext *ctx)
+{
+    if (JS_IsNull(ctx->class_proto[JS_CLASS_DATE])) {
+        JSValue ctor =
+            JS_CreateIntrinsicDate(ctx, JS_NEW_CTOR_NO_GLOBAL);
+        if (JS_IsException(ctor)) {
+            JS_FreeValue(ctx, ctx->class_proto[JS_CLASS_DATE]);
+            ctx->class_proto[JS_CLASS_DATE] = JS_NULL;
+            return -1;
+        }
+        ctx->lazy_date_ctor = ctor;
+    }
+    return 0;
+}
