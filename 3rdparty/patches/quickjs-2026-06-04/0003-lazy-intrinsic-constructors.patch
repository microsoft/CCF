+int JS_AddIntrinsicDate(JSContext *ctx)
+{
+    /* Remove JS_NewContext's lazy global before eager initialization. */
+    if (JS_DeleteProperty(ctx, ctx->global_obj, JS_ATOM_Date, 0) < 0)
+        return -1;
+    JS_FreeValue(ctx, ctx->lazy_date_ctor);
+    ctx->lazy_date_ctor = JS_NULL;
+    JSValue obj = JS_CreateIntrinsicDate(ctx, 0);
     if (JS_IsException(obj))
         return -1;
     JS_FreeValue(ctx, obj);
     return 0;
 }
 
+typedef enum {
+    JS_LAZY_INTRINSIC_DATE,
+    JS_LAZY_INTRINSIC_MAP,
+    JS_LAZY_INTRINSIC_SET,
+    JS_LAZY_INTRINSIC_WEAK_MAP,
+    JS_LAZY_INTRINSIC_WEAK_SET,
+} JSLazyIntrinsicEnum;
+
+static JSValue js_instantiate_intrinsic(JSContext *ctx, JSObject *p,
+                                        JSAtom atom, void *opaque)
+{
+    JSLazyIntrinsicEnum intrinsic = (JSLazyIntrinsicEnum)(uintptr_t)opaque;
+    JSValue value;
+
+    (void)p;
+    switch (intrinsic) {
+    case JS_LAZY_INTRINSIC_DATE:
+        assert(atom == JS_ATOM_Date);
+        if (JS_EnsureIntrinsicDate(ctx)) {
+            value = JS_EXCEPTION;
+        } else if (!JS_IsNull(ctx->lazy_date_ctor)) {
+            value = ctx->lazy_date_ctor;
+            ctx->lazy_date_ctor = JS_NULL;
+        } else {
+            value = JS_GetProperty(
+                ctx, ctx->class_proto[JS_CLASS_DATE], JS_ATOM_constructor);
+        }
+        break;
+    case JS_LAZY_INTRINSIC_MAP:
+    case JS_LAZY_INTRINSIC_SET:
+    case JS_LAZY_INTRINSIC_WEAK_MAP:
+    case JS_LAZY_INTRINSIC_WEAK_SET:
+        assert(atom == JS_ATOM_Map +
+               (intrinsic - JS_LAZY_INTRINSIC_MAP));
+        value = JS_CreateIntrinsicMapSet(
+            ctx,
+            intrinsic - JS_LAZY_INTRINSIC_MAP,
+            JS_NEW_CTOR_NO_GLOBAL);
+        break;
+    default:
+        abort();
+    }
+    return value;
+}
+
+static int JS_AddLazyIntrinsicConstructors(JSContext *ctx)
+{
+    static const struct {
+        JSAtom atom;
+        JSLazyIntrinsicEnum intrinsic;
+    } lazy_intrinsics[] = {
+        { JS_ATOM_Date, JS_LAZY_INTRINSIC_DATE },
+        { JS_ATOM_Map, JS_LAZY_INTRINSIC_MAP },
+        { JS_ATOM_Set, JS_LAZY_INTRINSIC_SET },
+        { JS_ATOM_WeakMap, JS_LAZY_INTRINSIC_WEAK_MAP },
+        { JS_ATOM_WeakSet, JS_LAZY_INTRINSIC_WEAK_SET },
+    };
+    size_t i;
+
+    for (i = 0; i < countof(lazy_intrinsics); i++) {
+        if (JS_DefineAutoInitProperty(
+                ctx,
+                ctx->global_obj,
+                lazy_intrinsics[i].atom,
+                JS_AUTOINIT_ID_INTRINSIC,
+                (void *)(uintptr_t)lazy_intrinsics[i].intrinsic,
+                JS_PROP_WRITABLE | JS_PROP_CONFIGURABLE) < 0)
+            return -1;
+    }
+    return 0;
+}
