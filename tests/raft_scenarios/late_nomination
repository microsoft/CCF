# Deliver a leadership nomination after its recipient has advanced to a later
# term. The delayed proposal must be ignored without changing the candidate.
pre_vote_enabled,false

start_node,0
emit_signature,2
trust_node,2,1
emit_signature,2

periodic_all,10
dispatch_all
periodic_all,10
dispatch_all
periodic_all,10
dispatch_all
assert_state_sync
assert_detail,0,current_view,2
assert_detail,1,current_view,2

# Node 0 queues a term-2 proposal for the only other node.
nominate_successor,0

# Node 1 advances to term 3 before receiving the proposal.
periodic_one,1,100
assert_detail,1,leadership_state,Candidate
assert_detail,1,current_view,3

# The term-2 proposal is now stale and must not restart node 1's candidacy.
dispatch_single,0,1
assert_detail,1,leadership_state,Candidate
assert_detail,1,current_view,3

# Complete the election and converge the nodes.
dispatch_single,1,0
dispatch_single,0,1
assert_detail,1,leadership_state,Leader
loop_until_sync
