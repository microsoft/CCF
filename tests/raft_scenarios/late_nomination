# Deliver a leadership nomination after its recipient has advanced to a later
# term. The delayed proposal must be ignored without changing the candidate.

start_node,0
emit_signature,2
trust_nodes,2,1,2
emit_signature,2

periodic_all,10
dispatch_all
periodic_all,10
dispatch_all
periodic_all,10
dispatch_all
assert_state_sync
assert_detail,0,current_view,2
assert_detail,2,current_view,2

# Equal progress makes node 2 the deterministic nomination target.
nominate_successor,0

# Node 2 obtains a pre-vote from node 1, without receiving the queued proposal.
periodic_one,2,100
assert_detail,2,leadership_state,PreVoteCandidate
assert_detail,2,current_view,2
dispatch_single,2,1
dispatch_single,1,2
assert_detail,2,leadership_state,Candidate
assert_detail,2,current_view,3

# The term-2 proposal is now stale and must not restart node 2's candidacy.
dispatch_single,0,2
assert_detail,2,leadership_state,Candidate
assert_detail,2,current_view,3

# Complete the election and converge the nodes.
dispatch_single,2,1
dispatch_single,1,2
assert_detail,2,leadership_state,Leader
loop_until_sync
