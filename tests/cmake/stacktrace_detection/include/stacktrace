      return 0;
    }
#if !defined(CCF_FIXTURE_NO_NATIVE_HANDLE)
    unsigned long native_handle() const
    {
      return 0;
    }
#endif
  };

  struct stacktrace
  {
    stacktrace_entry entry;
    static stacktrace current(unsigned long, unsigned long)
    {
      return {};
    }
    const stacktrace_entry* begin() const
    {
      return &entry;
    }
    const stacktrace_entry* end() const
    {
      return &entry + 1;
    }
  };
