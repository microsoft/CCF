import CftDriver

open CftDriver

-- Replicate a realistic burst of medium-sized application entries. Their encoded
-- size crosses the AppendEntries target, forcing the leader to recalculate
-- batching and proactively send them before followers commit normally.
initialize scenario "large_entry_batching" do
  startNode 0
  replicate 2 [signature]
  trustNodes 2 [1, 2]
  replicate 2 [signature]
  dispatchAll
  periodicAll 10
  dispatchAll
  periodicAll 10
  dispatchAll
  assertStateSync
  replicate 2
    [""]
  replicate 2
    [""]
  replicate 2
    [""]
  replicate 2 [signature]
  dispatchAll
  periodicAll 10
  dispatchAll
  periodicAll 10
  dispatchAll
  assertCommitIdx 0 8
  assertStateSync
