      have candidateEntrySafe :
          forall entry,
            entry ∈ (state.nodes candidate).log ->
              entry.term < (state.nodes candidate).currentTerm \/
                (entry.term = (state.nodes candidate).currentTerm /\
                  forall record,
                    elections (state.nodes candidate).currentTerm =
