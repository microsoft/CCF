    entry ∈ log := by
  unfold entryAt? at found
  split at found
  · simp at found
  · rw [List.getElem?_eq_some_iff] at found
    rcases found with ⟨within, valueEq⟩
    have member : log[index - 1] ∈ log :=
      List.getElem_mem within
    rw [valueEq] at member
    exact member

