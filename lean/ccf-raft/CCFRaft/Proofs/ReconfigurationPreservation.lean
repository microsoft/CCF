        · simpa [updateQueue, Function.update, leaderEq] using member
      exact
        ⟨queuedResponse, afterMember, success,
          by simpa [termEq] using responseTerm,
          sourceEq, responseDestination, lastIndex,
          by simpa [logEq] using covered⟩

