        · exact False.elim (supporterEq self)
        · let response :=
            grantedVoteKey
              supporter (state.nodes candidate).currentTerm candidate
          have candidateEntrySafe :
              forall entry,
                entry ∈ voteCandidateHistory response ->
                  entry.term < (state.nodes candidate).currentTerm \/
